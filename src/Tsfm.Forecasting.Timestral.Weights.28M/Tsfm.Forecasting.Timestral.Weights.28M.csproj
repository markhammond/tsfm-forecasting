<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <AssemblyName>Tsfm.Forecasting.Timestral.Weights.28M</AssemblyName>
        <RootNamespace>Tsfm.Forecasting.Timestral.Weights</RootNamespace>
        <PackageId>Tsfm.Forecasting.Timestral.Weights.28M</PackageId>
        <Description>Timestral-28M (27.8M) weights for Tsfm.Forecasting.Timestral, embedded as assembly resources (~111 MB), redistributed unmodified from Mistral AI at the revision recorded in LICENSE.txt. NOT open source: Mistral's Modified MIT licence grants no rights to anyone whose company or employer exceeds USD 20M monthly revenue.</Description>
        <PackageTags>timestral;mistral;timeseries;forecasting;weights;model</PackageTags>
        <IsPackable>true</IsPackable>
        <!-- The weights' own licence, not an SPDX expression: it is not an OSI licence, and a
             consumer must accept it rather than inherit it unseen. -->
        <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
        <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
        <!-- The repository's MIT LICENSE is not packed: it does not cover the weights, and
             LICENSE.txt carries the loader code's MIT notice itself. -->
        <PackRepositoryLicense>false</PackRepositoryLicense>
        <!-- Checkpoints are fetched, not committed. See scripts/fetch-timestral-checkpoint.sh. -->
        <TimestralCheckpointRoot Condition="'$(TimestralCheckpointRoot)' == ''">$(MSBuildThisFileDirectory)../../checkpoints</TimestralCheckpointRoot>
        <Snapshot>$(TimestralCheckpointRoot)/Timestral-28M</Snapshot>
        <PinnedSha256>dfc83c6220937ce5fc6687b35a4df94cd25e28a2cfe6fb92a23dad6301b2015d</PinnedSha256>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="../Tsfm.Forecasting.Timestral/Tsfm.Forecasting.Timestral.csproj" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="$(Snapshot)/model.safetensors" LogicalName="timestral.model" />
        <EmbeddedResource Include="$(Snapshot)/config.json" LogicalName="timestral.config" />
        <EmbeddedResource Include="$(Snapshot)/LICENSE" LogicalName="timestral.license" />
    </ItemGroup>

    <ItemGroup>
        <None Include="LICENSE.txt"
              Pack="true"
              PackagePath="" />
    </ItemGroup>

    <!-- The payload is checked against the pinned revision's SHA-256 before it is embedded:
         a refreshed or truncated checkpoint would build cleanly and forecast differently. -->
    <Target Name="AssertCheckpointPinned" BeforeTargets="BeforeBuild">
        <Error Condition="!Exists('$(Snapshot)/model.safetensors')"
               Text="Checkpoint missing: $(Snapshot)/model.safetensors. Run scripts/fetch-timestral-checkpoint.sh, or set TimestralCheckpointRoot to a directory holding Timestral-28M." />
        <GetFileHash Files="$(Snapshot)/model.safetensors" Algorithm="SHA256" HashEncoding="hex">
            <Output TaskParameter="Hash" PropertyName="ActualSha256" />
        </GetFileHash>
        <Error Condition="'$(ActualSha256.ToLowerInvariant())' != '$(PinnedSha256)'"
               Text="$(Snapshot)/model.safetensors is not Timestral-28M @ 180698bbf5a5 (sha256 $(ActualSha256)). Re-fetch with scripts/fetch-timestral-checkpoint.sh." />
    </Target>

</Project>
